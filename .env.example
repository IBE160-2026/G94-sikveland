# Copy to .env and fill in. Never commit .env.

# Claude API key. Leave empty in demo mode (MOCK_LLM=true).
ANTHROPIC_API_KEY=

# Models and effort (low, medium, high, xhigh, max).
MODEL_ANSWER=claude-opus-5-5
MODEL_SMALL=claude-haiku-5-5
EFFORT_ANSWER=medium
EFFORT_SMALL=low

# true = demo mode with stored answers, no API key needed.
MOCK_LLM=false

# Contact shown when the chatbot cannot help.
ADVISER_CONTACT=ngan.visaa@gmail.com

# SQLite file for feedback answers.
DATABASE_PATH=data/feedback.sqlite3

# Prices in USD per million tokens, from Anthropic's pricing page.
# Cache write = 1.25 x input. PRICE_SMALL_CACHE_READ is 0.1 x input; check it
# on the pricing page (the small model sends no cached prefix today).
PRICE_ANSWER_INPUT=4.00
PRICE_ANSWER_OUTPUT=20.00
PRICE_ANSWER_CACHE_READ=0.20
PRICE_ANSWER_CACHE_WRITE=5.00
PRICE_SMALL_INPUT=0.10
PRICE_SMALL_OUTPUT=0.50
PRICE_SMALL_CACHE_READ=0.01
PRICE_SMALL_CACHE_WRITE=0.125
