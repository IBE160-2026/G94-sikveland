# Copy to .env and fill in. Never commit .env.

# Claude API key. Leave empty in demo mode (MOCK_LLM=true).
ANTHROPIC_API_KEY=

# Models and effort (low, medium, high, xhigh, max).
MODEL_ANSWER=claude-opus-5-5
MODEL_SMALL=claude-haiku-5-5
EFFORT_ANSWER=medium
EFFORT_SMALL=low

# true = demo mode with stored answers, no API key needed.
MOCK_LLM=false

# Who answers when demo mode is off: anthropic (Claude, needs ANTHROPIC_API_KEY)
# or ollama (a local Ollama server, no key, no cost). MOCK_LLM=true wins over this.
LLM_PROVIDER=anthropic

# Ollama, used only with LLM_PROVIDER=ollama. OLLAMA_MODEL must be pulled first
# (ollama pull qwen3.5:9b) and must support thinking (e.g. qwen3.5): every request
# turns thinking on, and a model without it fails every answer with HTTP 400.
# OLLAMA_NUM_CTX is the context window in tokens, at least 32768: the knowledge
# base is ~24,600 tokens, and Ollama's default of 4096 silently cuts it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=32768

# Contact shown when the chatbot cannot help.
ADVISER_CONTACT=ngan.visaa@gmail.com

# SQLite file for the feedback answers (Yes/No only); a relative path is resolved
# against the project root. Created on the first answer.
DATABASE_PATH=data/feedback.sqlite3

# Request log: one JSON line per question (cost, tokens, outcome; never the text).
# A relative path is from the project root.
REQUEST_LOG_PATH=data/requests.jsonl

# Prices in USD per million tokens, from Anthropic's pricing page.
# Cache write = 1.25 x input. PRICE_SMALL_CACHE_READ is 0.1 x input; check it
# on the pricing page (the small model sends no cached prefix today).
PRICE_ANSWER_INPUT=4.00
PRICE_ANSWER_OUTPUT=20.00
PRICE_ANSWER_CACHE_READ=0.20
PRICE_ANSWER_CACHE_WRITE=5.00
PRICE_SMALL_INPUT=0.10
PRICE_SMALL_OUTPUT=0.50
PRICE_SMALL_CACHE_READ=0.01
PRICE_SMALL_CACHE_WRITE=0.125
